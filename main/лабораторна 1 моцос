import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import quad

# ============================================================
# ЛАБОРАТОРНА РОБОТА №1
# Наближення функції тригонометричним рядом Фур'є
# Варіант n = 3
# Порядок ряду N = 10
# ============================================================

# ============================================================
# 1. ПІДКЛЮЧЕННЯ БІБЛІОТЕК
# ============================================================

# numpy використовую для математичних обчислень,
# matplotlib — для побудови графіків,
# quad — для чисельного обчислення інтегралів.

# ============================================================
# 2. ЗАДАННЯ ВАРІАНТА І ПОЧАТКОВИХ ДАНИХ
# ============================================================

# Маленьке n = 3 — це номер мого варіанта.
# Тому функція:
# f(x) = 3 * sin(3*pi*x)
# на інтервалі від 0 до pi.

n = 3

# Межі інтервалу
L_start = 0
L_end = np.pi

# Довжина інтервалу
T = L_end - L_start

# Основна кутова частота
w0 = 2 * np.pi / T

# ============================================================
# 3. ДОПОМІЖНА ФУНКЦІЯ ДЛЯ ВИВЕДЕННЯ ЧИСЕЛ
# ============================================================

# Якщо після округлення число дорівнює нулю,
# виводжу звичайний 0.0000000000, а не -0.0000000000.

def format_number(value, digits=10):

    value = float(value)

    rounded_value = round(value, digits)

    if rounded_value == 0:
        rounded_value = 0.0

    return f"{rounded_value:.{digits}f}"

# ============================================================
# 4. ТОЧНЕ АНАЛІТИЧНЕ ЗНАЧЕННЯ ФУНКЦІЇ
# ============================================================

# Ця функція обчислює точне значення
# початкової функції для будь-якого x.

def exact_f(x):

    return n * np.sin(np.pi * n * x)

# ============================================================
# 5. ОКРЕМЕ ОБЧИСЛЕННЯ a_0
# ============================================================

# a_0 обчислюю окремо за формулою:
#
# a_0 = (2 / T) * інтеграл f(x) dx
#
# Для a_0 косинус не потрібний,
# тому що cos(0) = 1.

def calculate_a0():

    integral_a0, _ = quad(
        exact_f,
        L_start,
        L_end
    )

    a0 = (2 / T) * integral_a0

    # Прибираю можливий -0
    if abs(a0) < 1e-12:
        a0 = 0.0

    return a0

# ============================================================
# 6. ОБЧИСЛЕННЯ КОЕФІЦІЄНТІВ ФУР'Є a_k ТА b_k
# ============================================================

# Тут обчислюю коефіцієнти a_k та b_k.
#
# a_0 вже обчислюється окремо.
#
# Для k = 1,...,N через інтеграли знаходжу:
#
# a_k — коефіцієнти при косинусах;
# b_k — коефіцієнти при синусах.

def calculate_fourier_coefficients(N):

    # Створюю масиви
    a_coeffs = np.zeros(N + 1)
    b_coeffs = np.zeros(N + 1)

    # --------------------------------------------------------
    # Окремо обчислюю a_0
    # --------------------------------------------------------

    a_coeffs[0] = calculate_a0()

    # --------------------------------------------------------
    # Обчислюю a_k та b_k для k = 1,...,N
    # --------------------------------------------------------

    for k in range(1, N + 1):

        # ----------------------------
        # Обчислення a_k
        # ----------------------------

        def integrand_a(x):

            return exact_f(x) * np.cos(k * w0 * x)

        integral_a, _ = quad(
            integrand_a,
            L_start,
            L_end
        )

        a_coeffs[k] = n % 2 == 0 ? funct¬_a_¬k : o

        # ----------------------------
        # Обчислення b_k
        # ----------------------------

        def integrand_b(x):

            return exact_f(x) * np.sin(k * w0 * x)

        integral_b, _ = quad(
            integrand_b,
            L_start,
            L_end
        )

        b_coeffs[k] = n % 2 == 0 ? 0 : (2 / T) * integral_b

    # --------------------------------------------------------
    # Прибираю дуже малі чисельні похибки
    # --------------------------------------------------------

    a_coeffs[np.abs(a_coeffs) < 1e-12] = 0.0
    b_coeffs[np.abs(b_coeffs) < 1e-12] = 0.0

    return a_coeffs, b_coeffs

# ============================================================
# 7. НАБЛИЖЕННЯ ФУНКЦІЇ РЯДОМ ФУР'Є
# ============================================================

# Спочатку береться:
#
# a_0 / 2
#
# Потім додаються гармоніки:
#
# a_k*cos(k*w0*x) + b_k*sin(k*w0*x)
#
# Велике N = 10, тому використовую
# гармоніки від 1 до 10.

def fourier_approximation(
    x,
    a_coeffs,
    b_coeffs,
    N
):

    x = np.asarray(x)

    # Початковий член a_0 / 2
    result = np.full(
        x.shape,
        a_coeffs[0] / 2,
        dtype=float
    )

    # Додаю гармоніки
    for k in range(1, N + 1):

        result += (
            a_coeffs[k]
            * np.cos(k * w0 * x)
            +
            b_coeffs[k]
            * np.sin(k * w0 * x)
        )

    return result

# ============================================================
# 8. ГРАФІК ОКРЕМИХ ГАРМОНІК
# ============================================================

# Графік показує внесок кожної гармоніки
# у загальне наближення функції.

def plot_harmonics(
    x,
    a_coeffs,
    b_coeffs,
    N
):

    plt.figure(figsize=(12, 7))

    # Нульова гармоніка
    harmonic_0 = np.full(
        x.shape,
        a_coeffs[0] / 2,
        dtype=float
    )

    plt.plot(
        x,
        harmonic_0,
        label="k = 0"
    )

    # Гармоніки від 1 до N
    for k in range(1, N + 1):

        harmonic = (
            a_coeffs[k]
            * np.cos(k * w0 * x)
            +
            b_coeffs[k]
            * np.sin(k * w0 * x)
        )

        plt.plot(
            x,
            harmonic,
            label=f"k = {k}",
            linewidth=1
        )

    plt.title(
        "Гармоніки тригонометричного ряду Фур'є"
    )

    plt.xlabel("x")
    plt.ylabel("hₖ(x)")
    plt.grid(True)

    plt.legend(
        ncol=2,
        fontsize=8
    )

    plt.tight_layout()
    plt.show()

# ============================================================
# 9. СПЕКТРИ КОЕФІЦІЄНТІВ a_k І b_k
# ============================================================

def plot_frequency_domain(
    a_coeffs,
    b_coeffs,
    N
):

    k_a = np.arange(0, N + 1)
    k_b = np.arange(1, N + 1)

    # --------------------------------------------------------
    # Графік a_k
    # --------------------------------------------------------

    plt.figure(figsize=(9, 5))

    # Для відображення беру модулі a_k,
    # тому на графіку вони не будуть від'ємними.
    plt.stem(
        k_a,
        np.abs(a_coeffs)
    )

    plt.title(
        "Модулі коефіцієнтів $a_k$ у частотній області"
    )

    plt.xlabel("k")
    plt.ylabel("|a_k|")
    plt.xticks(k_a)
    plt.grid(True)
    plt.tight_layout()
    plt.show()

    # --------------------------------------------------------
    # Графік b_k
    # --------------------------------------------------------

    plt.figure(figsize=(9, 5))

    plt.stem(
        k_b,
        b_coeffs[1:]
    )

    plt.title(
        "Коефіцієнти $b_k$ у частотній області"
    )

    plt.xlabel("k")
    plt.ylabel("$b_k$")
    plt.xticks(k_b)
    plt.grid(True)
    plt.tight_layout()
    plt.show()

# ============================================================
# 10. ПОРІВНЯННЯ ТОЧНОЇ І НАБЛИЖЕНОЇ ФУНКЦІЙ
# ============================================================

def plot_approximation(
    x,
    y_exact,
    y_approx
):

    plt.figure(figsize=(11, 6))

    # Точна функція
    plt.plot(
        x,
        y_exact,
        label="Точне значення f(x)",
        linewidth=2
    )

    # Наближена функція
    plt.plot(
        x,
        y_approx,
        "--",
        label="Наближення рядом Фур'є",
        linewidth=2
    )

    plt.title(
        "Точна функція та її наближення рядом Фур'є"
    )

    plt.xlabel("x")
    plt.ylabel("f(x)")
    plt.grid(True)
    plt.legend()
    plt.tight_layout()
    plt.show()

# ============================================================
# 11. ОБЧИСЛЕННЯ ВІДНОСНОЇ ПОХИБКИ
# ============================================================

# Похибка показує, наскільки наближена
# функція відрізняється від точної.

def calculate_relative_error(
    y_exact,
    y_approx
):

    numerator = np.linalg.norm(
        y_exact - y_approx
    )

    denominator = np.linalg.norm(
        y_exact
    )

    if denominator == 0:
        return 0.0

    relative_error = (
        numerator / denominator
    )

    return relative_error

# ============================================================
# 12. ЗБЕРЕЖЕННЯ РЕЗУЛЬТАТІВ У ФАЙЛ
# ============================================================

def save_results_to_file(
    filename,
    N,
    a_coeffs,
    b_coeffs,
    relative_error
):

    with open(
        filename,
        "w",
        encoding="utf-8"
    ) as file:

        file.write(
            f"Порядок ряду Фур'є N = {N}\n\n"
        )

        # ----------------------------------------------------
        # a_0
        # ----------------------------------------------------

        file.write(
            "Окремо обчислений a_0:\n"
        )

        file.write(
            f"a_0 = "
            f"{format_number(abs(a_coeffs[0]))}\n\n"
        )

        # ----------------------------------------------------
        # Коефіцієнти a_k
        # ----------------------------------------------------

        file.write(
            "Модулі коефіцієнтів a_k:\n"
        )

        for k in range(N + 1):

            # Для відображення беру модуль,
            # тому мінуса не буде.
            value = format_number(
                abs(a_coeffs[k])
            )

            file.write(
                f"a_{k} = {value}\n"
            )

        # ----------------------------------------------------
        # Коефіцієнти b_k
        # ----------------------------------------------------

        file.write(
            "\nКоефіцієнти b_k:\n"
        )

        for k in range(1, N + 1):

            value = format_number(
                b_coeffs[k]
            )

            file.write(
                f"b_{k} = {value}\n"
            )

        # ----------------------------------------------------
        # Похибка
        # ----------------------------------------------------

        file.write(
            "\nВідносна похибка наближення:\n"
        )

        file.write(
            f"{format_number(relative_error)}\n"
        )

        file.write(
            f"{format_number(relative_error * 100, 6)}%\n"
        )

    print(
        f"\nРезультати збережено у файл: {filename}"
    )

# ============================================================
# 13. ГОЛОВНА ПРОГРАМА
# ============================================================

def main():

    # Велике N = 10 — порядок ряду Фур'є
    N = 10

    # --------------------------------------------------------
    # Створюю 2000 точок на інтервалі [0, pi]
    # --------------------------------------------------------

    x_vals = np.linspace(
        L_start,
        L_end,
        2000
    )

    # --------------------------------------------------------
    # Точні значення
    # --------------------------------------------------------

    y_exact = exact_f(
        x_vals
    )

    # --------------------------------------------------------
    # Коефіцієнти Фур'є
    # --------------------------------------------------------

    a_coeffs, b_coeffs = (
        calculate_fourier_coefficients(N)
    )

    # --------------------------------------------------------
    # Наближення рядом Фур'є
    # --------------------------------------------------------

    y_approx = fourier_approximation(
        x_vals,
        a_coeffs,
        b_coeffs,
        N
    )

    # --------------------------------------------------------
    # Похибка
    # --------------------------------------------------------

    relative_error = (
        calculate_relative_error(
            y_exact,
            y_approx
        )
    )

    # ========================================================
    # ВИВЕДЕННЯ РЕЗУЛЬТАТІВ
    # ========================================================

    print("=" * 65)

    print(
        "ЛАБОРАТОРНА РОБОТА №1"
    )

    print(
        "Наближення функції тригонометричним рядом Фур'є"
    )

    print("=" * 65)

    print(
        f"\nВаріант n = {n}"
    )

    print(
        "Функція: f(x) = 3 * sin(3*pi*x)"
    )

    print(
        "Інтервал: [0, pi]"
    )

    print(
        f"Порядок ряду: N = {N}"
    )

    # --------------------------------------------------------
    # Окремо виводжу a_0
    # --------------------------------------------------------

    print(
        "\nОкремо обчислений a_0:"
    )

    print(
        "a_0 = "
        + format_number(
            abs(a_coeffs[0])
        )
    )

    # --------------------------------------------------------
    # Виводжу a_k без від'ємних значень
    # --------------------------------------------------------

    print(
        "\nМодулі коефіцієнтів a_k:"
    )

    for k in range(N + 1):

        # Для відображення використовую модуль.
        value = format_number(
            abs(a_coeffs[k])
        )

        print(
            f"a_{k} = {value}"
        )

    # --------------------------------------------------------
    # Виводжу b_k
    # --------------------------------------------------------

    print(
        "\nКоефіцієнти b_k:"
    )

    for k in range(1, N + 1):

        value = format_number(
            b_coeffs[k]
        )

        print(
            f"b_{k} = {value}"
        )

    # --------------------------------------------------------
    # Перевірка у точці x = pi/2
    # --------------------------------------------------------

    test_x = np.pi / 2

    test_exact = exact_f(
        test_x
    )

    test_approx = fourier_approximation(
        np.array([test_x]),
        a_coeffs,
        b_coeffs,
        N
    )[0]

    print(
        "\nПеревірка в точці x = pi/2:"
    )

    print(
        "Точне значення: "
        + format_number(test_exact)
    )

    print(
        "Наближене значення: "
        + format_number(test_approx)
    )

    # --------------------------------------------------------
    # Похибка
    # --------------------------------------------------------

    print(
        "\nВідносна похибка наближення = "
        + format_number(relative_error)
    )

    print(
        "Відносна похибка у відсотках = "
        + format_number(
            relative_error * 100,
            6
        )
        + "%"
    )

    # --------------------------------------------------------
    # Зберігаю результати
    # --------------------------------------------------------

    save_results_to_file(
        "fourier_results_var3_N10.txt",
        N,
        a_coeffs,
        b_coeffs,
        relative_error
    )

    # --------------------------------------------------------
    # Графік точної та наближеної функції
    # --------------------------------------------------------

    plot_approximation(
        x_vals,
        y_exact,
        y_approx
    )

    # --------------------------------------------------------
    # Гармоніки
    # --------------------------------------------------------

    plot_harmonics(
        x_vals,
        a_coeffs,
        b_coeffs,
        N
    )

    # --------------------------------------------------------
    # Спектри
    # --------------------------------------------------------

    plot_frequency_domain(
        a_coeffs,
        b_coeffs,
        N
    )

# ============================================================
# ЗАПУСК ГОЛОВНОЇ ПРОГРАМИ
# ============================================================

if __name__ == "__main__":
    main()
